# ── Public (bundled into the browser build by Vite) ─────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_API_KEY=your_google_api_key
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Server-only (server.js). NEVER prefix these with VITE_ ───────────────────
PORT=3000
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public API (/api/public) — read-only stats + leaderboards for other sites.
# See docs/PUBLIC_API.md. Both are optional.
#   PUBLIC_API_ORIGINS  Comma-separated sites allowed to call it from a browser.
#                       Unset = any origin, which is fine for public data.
#   PUBLIC_API_CACHE_SECONDS  How long responses are cached (default 300).
# PUBLIC_API_ORIGINS=https://fingerlakesclimatefund.org,https://www.fingerlakesclimatefund.org
# PUBLIC_API_CACHE_SECONDS=300

# Email notifications (Cloud Functions)
# Add these to functions/.env — NOT this file
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=you@example.com
# MAIL_SMTP_PASS=your_app_password
# MAIL_FROM="Finger Lakes Climate Fund <noreply@example.com>"
# APP_URL=https://your-app.web.app
