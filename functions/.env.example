MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=you@example.com
MAIL_SMTP_PASS=your_app_password
MAIL_FROM="Finger Lakes Climate Fund <noreply@example.com>"
APP_URL=https://your-app.web.app

# Little Green Light gift sync. Leave disabled while importing data or while
# the client is testing; set to true at launch.
LGL_SYNC_ENABLED=false
LGL_WEBHOOK_URL=https://sustainabletompkins.littlegreenlight.com/integrations/<integration-id>/listener
