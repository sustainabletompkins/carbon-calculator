rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are Firebase Auth users carrying the `admin` custom claim,
    // set via `npm run admin:grant -- <email>` (scripts/setAdminClaim.js).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Cart items: allow unauthenticated users to read/write their own items by email
    match /cartItems/{cartItemId} {
      allow read, write: if true;
    }

    // Offsets: public read, allow client writes for saving purchase records
    match /offsets/{offsetId} {
      allow read: if true;
      allow create: if true;
      // Editing or removing purchase records is admin-only
      allow update, delete: if isAdmin();
    }

    // Users: allow read/write (email-based identity, no auth)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Teams: public read, allow writes for team management
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
    }

    // Team members: public read, allow writes
    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Regions: public read, admin-managed
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only settings/config documents
    match /adminSettings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
